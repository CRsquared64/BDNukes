<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build:   dotnet build -c Release
    KSP install location defaults to two folders above this file (repo checked out inside the KSP folder).
    Override with:  dotnet build -c Release -p:KSPDir="C:\path\to\Kerbal Space Program"
    or set the KSPDIR environment variable.
    The DLL goes to ../GameData/BDNukes/Plugins, and the whole GameData/BDNukes folder is then copied into the KSP install.
  -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>BDNukes</AssemblyName>
    <RootNamespace>BDNukes</RootNamespace>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <Version>1.3.1</Version>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <KSPDir Condition="'$(KSPDir)' == '' and '$(KSPDIR)' != ''">$(KSPDIR)</KSPDir>
    <KSPDir Condition="'$(KSPDir)' == ''">$(MSBuildProjectDirectory)\..\..</KSPDir>
    <KSPManaged>$(KSPDir)\KSP_x64_Data\Managed</KSPManaged>
    <RepoModDir>$(MSBuildProjectDirectory)\..\GameData\BDNukes</RepoModDir>
    <InstallModDir>$(KSPDir)\GameData\BDNukes</InstallModDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(KSPManaged)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(KSPManaged)\Assembly-CSharp-firstpass.dll" Private="false" />
    <Reference Include="$(KSPManaged)\UnityEngine*.dll" Private="false" />
    <Reference Include="$(KSPDir)\GameData\BDArmory\Plugins\BDArmory.dll" Private="false" />
    <Reference Include="$(KSPDir)\GameData\000_Harmony\0Harmony.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- shared with the Unity shader project, so its test renders use exactly the uniforms the plugin sends -->
    <Compile Include="..\unity\Assets\Shared\NukeVolumeShader.cs" Link="Shared\NukeVolumeShader.cs" />
    <Compile Include="..\unity\Assets\Shared\NukeSimPlayer.cs" Link="Shared\NukeSimPlayer.cs" />
  </ItemGroup>

  <Target Name="StageAndInstall" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(RepoModDir)\Plugins" />
    <ItemGroup>
      <ModFiles Include="$(RepoModDir)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ModFiles)" DestinationFiles="@(ModFiles->'$(InstallModDir)\%(RecursiveDir)%(Filename)%(Extension)')"
          Condition="Exists('$(KSPDir)\GameData') and '$(SkipInstall)' != 'true'" SkipUnchangedFiles="true"
          Retries="1" ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
